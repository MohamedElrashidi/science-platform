# انسخ هذا الملف إلى .env.local وعبّئ القيم من: Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# سري: للخادم فقط. لا تضعه في أي متغير يبدأ بـ NEXT_PUBLIC_ ولا ترفعه إلى GitHub
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# نطاق البريد الداخلي لحسابات الطلاب (لا يُرسل إليه بريد فعلي)
STUDENT_EMAIL_DOMAIN=students.example.com
# اختياري لاحقاً: توليد الأسئلة بالذكاء الاصطناعي
ANTHROPIC_API_KEY=
